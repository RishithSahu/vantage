# The assistant as a hardened systemd service: no network, no vehicle bus, no write access to the vehicle's files, no way to see or signal other processes, no real-time priority, only the cores and memory it is given.
# These are the same properties tools_isolation_rig.py ran on a Raspberry Pi 4 (docs/SAFETY_ISOLATION.md): 22 of 22 escape attempts refused, 0 missed deadlines of a 100 Hz real-time loop under every attack.
# Fill the @...@ values at install time, then: sudo install -m 644 vgpt-assistant.service /etc/systemd/system/ && sudo systemctl enable --now vgpt-assistant
# Keep the vehicle's own functions off the cores in AllowedCPUs (kernel command line isolcpus=<their cores>, or a cpuset slice for the vehicle).
[Unit]
Description=Vantage assistant (hardened, no network, no bus)
After=local-fs.target

[Service]
Type=exec
User=@USER@
WorkingDirectory=@APP_DIR@
# The assistant process that answers the cockpit. It has no network: the cockpit reaches it over standard input/output or a Unix-domain socket in @STATE_DIR@ (AF_UNIX is the one family left open).
# The rig's real-assistant load (a hardened unit answering questions as fast as it can) is: ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/bench/isolation_load.py ask 60
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=2
ReadWritePaths=@STATE_DIR@
# --- what it may use ---
MemoryMax=2G
TasksMax=256
CPUQuota=200%
AllowedCPUs=2-3
# --- what it may not do ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivatePIDs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
LimitNOFILE=4096
MemorySwapMax=0
IOWeight=20

[Install]
WantedBy=multi-user.target
