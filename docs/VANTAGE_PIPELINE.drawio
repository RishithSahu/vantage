<mxfile host="app.diagrams.net"><diagram id="vantage" name="Pipeline"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;VANTAGE / VehicleGPT: what happens, when, why, where, and what comes out&lt;/b&gt;  &lt;span style='font-size:14px'&gt;Read each band left to right or right to left as the arrows show; the data journey is bands 1 to 4, a question's journey is bands 5 to 10&lt;/span&gt;" style="text;html=1;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2400" height="40" as="geometry"/></mxCell><mxCell id="n2" value="KEY: what each symbol means" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#9aa0a6;swimlaneFillColor=#ffffff;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="2780" height="280" as="geometry"/></mxCell><mxCell id="n3" value="1. THE CAR  (a separate program: a simulated vehicle here, the real bus in a real car)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#fff6ee;strokeColor=#9aa0a6;swimlaneFillColor=#fff6ee;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="366" width="2780" height="280" as="geometry"/></mxCell><mxCell id="n4" value="2. THE PIPE  (the only thing between the car and Vantage)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#fff6ee;strokeColor=#9aa0a6;swimlaneFillColor=#fff6ee;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="662" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n5" value="3. VANTAGE LEARNS WHAT THE CAR IS  (receiver and runtime, on the Raspberry Pi or the head unit)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#eef4ff;strokeColor=#9aa0a6;swimlaneFillColor=#eef4ff;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1188" width="2780" height="740" as="geometry"/></mxCell><mxCell id="n6" value="4. STORAGE  (one writer, everyone else read-only; the question flow below reads from here)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#eefaee;strokeColor=#9aa0a6;swimlaneFillColor=#eefaee;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1944" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n7" value="5. SOMEONE ASKS  (a new flow that starts whenever a person asks; guards run before the model is ever used)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#fdf0f0;strokeColor=#9aa0a6;swimlaneFillColor=#fdf0f0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="2470" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n8" value="6. THE MODEL READS THE QUESTION  (the only learned part)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#f5eefa;strokeColor=#9aa0a6;swimlaneFillColor=#f5eefa;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="2996" width="2780" height="280" as="geometry"/></mxCell><mxCell id="n9" value="7. CAN WE TRUST THE READING?" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#fff9e6;strokeColor=#9aa0a6;swimlaneFillColor=#fff9e6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="3292" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n10" value="8. CODE CALCULATES THE ANSWER  (no model, read-only SQL)" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#eef4ff;strokeColor=#9aa0a6;swimlaneFillColor=#eef4ff;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="3818" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n11" value="9. WORDS, CHECKS AND PRIVACY" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#eefaee;strokeColor=#9aa0a6;swimlaneFillColor=#eefaee;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="4344" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n12" value="10. WHAT THE PERSON GETS" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#fff6ee;strokeColor=#9aa0a6;swimlaneFillColor=#fff6ee;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="4870" width="2780" height="280" as="geometry"/></mxCell><mxCell id="n13" value="11. GUARANTEES THAT HOLD THE WHOLE TIME, HOW IT IS SHIPPED, HOW WE KNOW IT WORKS" style="swimlane;startSize=34;fontSize=14;fontStyle=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#9aa0a6;swimlaneFillColor=#f5f5f5;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="5166" width="2780" height="510" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Something coming in&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Data, a question, a person acting" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="85" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Code step (blue)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Ordinary program logic that calculates or checks" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="425" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;THE MODEL (purple hexagon)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; The only place a learned model is used" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=26;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="765" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;A decision&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Yes goes one way, No the other&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Stored data&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Database, archive or sealed file" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1445" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Something that comes out&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; An answer, a report, a refusal" style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1785" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Safety or refusal (red)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Protects the car, the person or the data" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2125" y="154" width="250" height="110" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;WHEN: a car is chosen, then every second it drives&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; One of 49 car models (EV, petrol, diesel, hybrid) with its own buses and protocols. It drives a simulated route or replays a recorded history, in real time (or 120x to 600x, or all at once).&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A test bench has to stand in for a real vehicle, with faults, weather and charging.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; The car's state each second: speed, charge, temperatures, tyres, faults." style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="438" width="300" height="175" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Turn state into what a real car's wires carry&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Writes raw CAN and CAN-FD, LIN, FlexRay, CANopen, J1939, OBD-II and UDS, SOME/IP, DoIP, Android VHAL, log lines, GPS sentences and camera pictures.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Vantage must learn from raw bytes, as in a real car.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Raw frames and messages, each with a time and a channel number." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="438" width="290" height="175" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Write to the pipe, write-only&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Wraps every message in a record: start marker, length, CRC-32, microsecond time, channel, bytes. Announces the VIN. A whole recorded history can also be handed over in one step.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; The car can only write. Vantage can never transmit to the car.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A one-way byte stream." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="438" width="290" height="175" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Or a real Android Automotive car&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; adb reads the Vehicle HAL values from an Android Automotive guest (tested on the Pi).&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Proves the same path works for a real vehicle OS.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; VHAL value parcels on the pipe." style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="438" width="300" height="175" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;WHERE: a local one-way pipe&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Windows named pipe or Linux FIFO, mode 0600. No network.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Offline by construction, and no way back to the car.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Bytes in order." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="976" width="220" height="150" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Is a record damaged?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;CRC or length wrong&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="966" width="300" height="170" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Skip to the next good record&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; The reader resynchronises on the start marker and counts what it skipped.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Damage count, never a crash." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="734" width="290" height="175" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Hand records to the receiver&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Collector thread reads; a separate store thread writes.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Reading must never wait for the disk.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Records: time, channel, bytes." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="964" width="290" height="175" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;WHEN: first bytes arrive. Sniff&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Looks at the bytes of every block and says what form it is: CAN frame, SOME/IP, VHAL parcel, picture, GPS sentence, JSON, log line.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Vantage is never told how this car sends data.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A form for every channel." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="1720" width="290" height="175" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Does an installed decoder file fit this car?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Scores CAN ids, SOME/IP services, VHAL properties&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="1722" width="300" height="170" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;No fit: learn from standards&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Reads OBD-II, J1939, VHAL, GPS standards. The signal mapper decides which quantity each signal is, and refuses when unsure (831 reviewed signals, 0 wrong).&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A wrong mapping is worse than none.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A new decoder file for this car." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="1490" width="290" height="175" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Still nothing found&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Says so and lists the unexplained CAN ids.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Report: unidentified network." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="1260" width="290" height="175" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Decode with this car's decoder file&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Turns bytes into named signals in standard units, events, log lines and thumbnails.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Everything after this point speaks the same language for every car.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Canonical signals, events, logs." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="1720" width="290" height="175" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Check the data before trusting it&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Plausible range, redundant sources, unknown or too-frequent CAN ids, stale or stuck sensors, harsh events. Freezes the signals around important events.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A number from a broken sensor must not become an answer.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Quality flags and frozen event context." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="1720" width="290" height="175" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Decide what kind of car this is&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Charge level means electric. Fuel level or engine speed means combustion. Both means hybrid.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A car never announces its type. It sends signals.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; EV, petrol, diesel or hybrid." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1425" y="1720" width="290" height="175" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Every 30 seconds: re-check&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; A clearly better decoder file replaces the current one. Two cars of one model are told apart by VIN.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; The car may change or reconnect.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Updated car identity." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="1260" width="290" height="175" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;The single writer stores everything&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Every record is written once, by one process.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; One writer means no two writers can corrupt the history.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Rows in the car's own database." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1425" y="2016" width="290" height="175" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Seconds&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; 14 days, every second" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="2028" width="220" height="150" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Minutes&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; 5 years, 31-byte rows" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="2028" width="220" height="150" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Daily&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Forever, tiny" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="2028" width="220" height="150" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;Records&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Events, trouble codes, logs, trips, charges, service. 5 years" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1460" y="2258" width="220" height="150" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;Lossless archive&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Old seconds, exactly, hash-chained. 6 GB budget, oldest removed first" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="2258" width="220" height="150" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Sealed at rest&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; AES-256-GCM on the disk. The working copy lives only in RAM and is wiped on exit.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A stolen card yields only ciphertext." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="2246" width="290" height="175" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;WHEN: a person asks&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Typed in the Ask page, or spoken: wake word Vantage, offline speech recognition, nothing leaves the device.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Hands-free while driving.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Question text." style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="2772" width="300" height="175" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;May this role do this?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Driver, engineer, fleet or validation. Deny by default&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="2774" width="300" height="170" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;Refused&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Route not allowed for this role.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Denied, logged without content." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="2542" width="290" height="175" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;Queue full or deadline passed?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;One worker, bounded queue&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="2774" width="300" height="170" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b&gt;Busy, at once&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; No waiting and no growing memory. A late job is never run.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Busy answer." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="2542" width="290" height="175" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b&gt;Is it a hazard question?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Can I keep driving with this warning&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="2774" width="300" height="170" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;Fixed safety answer&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Decided by rules before and without the model. A warning count never answers a safety question.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Safety advice." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="2542" width="290" height="175" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;Repair spelling and shorthand&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Fixes typos and shorthand (avg, batety). If a shorthand has exactly two meanings, asks which.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A 0.5B model should be helped, not trusted with everything.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Cleaned question plus a visible note: I read it as." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1425" y="2772" width="290" height="175" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;Needs no model at all?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Who are you, the time, service record, trip estimate, out of scope&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1760" y="2774" width="300" height="170" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b&gt;Answered directly&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; From the car's own tables. Law, prices and weather are said to be outside its data.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Answer." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1765" y="2542" width="290" height="175" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b&gt;A long multi-part analysis request?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Two or more analysis cues&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2100" y="2774" width="300" height="170" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b&gt;Investigation engine&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; 32 analyses (incidents, change points, lead times, outlier trips). Never calls the model.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Report with facts, associations and possibilities kept apart. Joins the answer at step 9." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2105" y="2542" width="290" height="175" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;Read the typed values first&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Dates, times, numbers, units. Last service becomes a real date from the car's own record.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A number is parsed, not guessed.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Typed values." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="2105" y="3068" width="290" height="175" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;THE MODEL reads the question&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Qwen2.5-0.5B with a LoRA adapter, int8, about 1.4 s on a Pi 4. Sees the question, glossary hints, the car type and, only if the wording points back, the last frame.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Free wording cannot be a rule list.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A frame of 8 words: act, concept, operator, condition, comparison, entity, second concept, reference. Plus a confidence." style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=26;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1745" y="3060" width="330" height="190" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;Token mask on the model&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Only words of the vehicle ontology can be written. It can never write SQL, a number about the car, or a command.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Prompt injection and hostile text cannot steer it.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Always a valid frame, or none." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1425" y="3068" width="290" height="175" as="geometry"/></mxCell><mxCell id="n59" value="&lt;b&gt;Fix known misreads&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Glossary words the model gets wrong, signals only this car declares, fuel asked of an EV means charge.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Small data fixes beat retraining.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Corrected frame, with the reason kept." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1765" y="3594" width="290" height="175" as="geometry"/></mxCell><mxCell id="n60" value="&lt;b&gt;Confidence below 0.50?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Calibrated: the share read right at that score&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="3596" width="300" height="170" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b&gt;I will not guess&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Shows how it read the question and asks to rephrase.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Refusal." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1425" y="3364" width="290" height="175" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b&gt;Confidence below 0.80?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Two readings possible&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="3596" width="300" height="170" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b&gt;Ask back: did you mean 1 or 2&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Offers the model's own two readings. The reply 1 or 2 continues.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Question to the person." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="3364" width="290" height="175" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;Unsafe or off-topic with weak evidence?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;No word of the question names the thing&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="3596" width="300" height="170" as="geometry"/></mxCell><mxCell id="n65" value="&lt;b&gt;Asked again or refused&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Not about this vehicle.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Polite decline." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="3364" width="290" height="175" as="geometry"/></mxCell><mxCell id="n66" value="&lt;b&gt;Complete follow-ups&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; And yesterday, which was longest, what about rear left, how did you get that. Filled in from the last turn.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; People speak in fragments.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A complete frame." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="3594" width="290" height="175" as="geometry"/></mxCell><mxCell id="n67" value="&lt;b&gt;Does the frame type-check?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Act, concept and operator must fit together&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="3596" width="300" height="170" as="geometry"/></mxCell><mxCell id="n68" value="&lt;b&gt;A specific clarification&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Says what it understood and what is missing.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Question to the person." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="3364" width="290" height="175" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b&gt;Frame becomes a typed query&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Validated against the registry. Checks the car really has this data.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Missing data is explained, never turned into zero.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A typed query, or: this car does not record that." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="3890" width="290" height="175" as="geometry"/></mxCell><mxCell id="n70" value="&lt;b&gt;Planner builds the only SQL&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Fixed templates, whitelisted names, bound values. Picks the cheapest tier that is exact enough.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; No model-written SQL exists anywhere.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A read-only plan." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="3890" width="290" height="175" as="geometry"/></mxCell><mxCell id="n71" value="&lt;b&gt;Database, read-only&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Seconds for short recent windows, minutes for history, daily for long, archive for exact old seconds, ledger for trips." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="3902" width="220" height="150" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;Executors calculate&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Statistics, trends with a yes or no verdict first, event counts and rates, trips, charging, fuel and economy, correlations, summaries.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; All numbers come from here, never from the model.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Numbers with their sample counts." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="3890" width="290" height="175" as="geometry"/></mxCell><mxCell id="n73" value="&lt;b&gt;Why? The cause engine (when act = why)&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Finds when a quantity changed, fits a physics model of the trips, ranks competing causes. Nothing changed is an allowed answer.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Explain, not just report.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A cause, the evidence, what was ruled out, a checked confidence." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="4120" width="290" height="175" as="geometry"/></mxCell><mxCell id="n74" value="&lt;b&gt;Scale to the machine&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Probes cores and memory: one wide context on a 2-core board, more worker processes on a vehicle computer.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Same code from a Pi to an HPC.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A configuration." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1765" y="4120" width="290" height="175" as="geometry"/></mxCell><mxCell id="n75" value="&lt;b&gt;Evidence is assembled&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Claim, numbers, units, samples, data tier, quality flags, gaps. Labelled measured, derived or estimated.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; An answer is only as strong as its data.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Evidence object." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="4646" width="290" height="175" as="geometry"/></mxCell><mxCell id="n76" value="&lt;b&gt;Words are written from the numbers&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Templates, no model. Verdict first, working underneath.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; A language model must not state a result.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Draft answer text." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="4646" width="290" height="175" as="geometry"/></mxCell><mxCell id="n77" value="&lt;b&gt;Does every number trace to the evidence?&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Also units and claims&lt;/i&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="4648" width="300" height="170" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;Safe fallback&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; The unsupported answer is withheld.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; A plainly worded fallback." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="4416" width="290" height="175" as="geometry"/></mxCell><mxCell id="n79" value="&lt;b&gt;Privacy and role&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Location, places and pictures only for the driver. Engineer gets the working, fleet gets KPIs, validation gets the evidence pack. Audit entry records what happened, never the content.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Same truth, different readers.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; The answer for this role." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="4646" width="290" height="175" as="geometry"/></mxCell><mxCell id="n80" value="&lt;b&gt;On screen&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; The answer, how it was read, the confidence, the evidence chips, Show your working.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Cockpit UI: Ask, Car, Energy, Map, Camera, Live." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="4942" width="290" height="175" as="geometry"/></mxCell><mxCell id="n81" value="&lt;b&gt;Spoken&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; Local voices only.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Audio." style="shape=document;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="4942" width="290" height="175" as="geometry"/></mxCell><mxCell id="n82" value="&lt;b&gt;Thumbs up or down&lt;/b&gt;&lt;br/&gt;&lt;b&gt;What:&lt;/b&gt; A small record, encrypted and expiring.&lt;br/&gt;&lt;b&gt;Why:&lt;/b&gt; Complaints become test cases.&lt;br/&gt;&lt;b&gt;Out:&lt;/b&gt; Feedback record." style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="4942" width="300" height="175" as="geometry"/></mxCell><mxCell id="n83" value="&lt;b&gt;Offline, enforced&lt;/b&gt;&lt;br/&gt;An audit hook refuses any socket that is not CAN and any name lookup. The service unit denies network. Nothing is ever downloaded." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="5238" width="290" height="175" as="geometry"/></mxCell><mxCell id="n84" value="&lt;b&gt;The AI cannot drive&lt;/b&gt;&lt;br/&gt;Two domains. The assistant imports no network, process or CAN code (a build test scans the source), cannot write the database, cannot transmit. Measured on a Pi 4: 0 missed deadlines, 22 of 22 escapes refused." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="405" y="5238" width="290" height="175" as="geometry"/></mxCell><mxCell id="n85" value="&lt;b&gt;Hardening&lt;/b&gt;&lt;br/&gt;No core dumps, not dumpable, private files, optional memory lock, memory guard, key from TPM or keyring." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="745" y="5238" width="290" height="175" as="geometry"/></mxCell><mxCell id="n86" value="&lt;b&gt;Where it runs&lt;/b&gt;&lt;br/&gt;Windows installer, Raspberry Pi 4 service (2 GB cap), Linux or QNX or Android Automotive as sources and displays. Tiers from 2 cores and 2 GB up to a vehicle HPC." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1085" y="5238" width="290" height="175" as="geometry"/></mxCell><mxCell id="n87" value="&lt;b&gt;How we know&lt;/b&gt;&lt;br/&gt;1765 tests, protocol oracles (cantools, scapy, udsoncan, J1939), a sealed cause test (87.8 percent first right, 0 percent confident false), kernel CAN checks on the Pi, release manifest." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1425" y="5238" width="290" height="175" as="geometry"/></mxCell><mxCell id="n88" value="&lt;b&gt;Stated limits&lt;/b&gt;&lt;br/&gt;Some long questions are still above 2 s on the Pi (reading the question is about 1.2 s). GPU untested. The vehicle HPC is a laptop stand-in." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1765" y="5238" width="290" height="175" as="geometry"/></mxCell><mxCell id="n89" value="&lt;b&gt;One question in numbers&lt;/b&gt;&lt;br/&gt;Pi 4, 2 cores, median about 1.4 s end to end. Most of it is the model reading the question." style="shape=note;size=14;fillColor=#fffbe6;strokeColor=#a8a29e;align=left;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="65" y="5468" width="290" height="175" as="geometry"/></mxCell><mxCell id="n90" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n91" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n92" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n24" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n93" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n94" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n95" value="yes" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n96" value="no" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n97" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n98" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n99" value="yes" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;" edge="1" parent="1" source="n30" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n100" value="no" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n101" value="nothing found" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n102" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="1577"/></Array></mxGeometry></mxCell><mxCell id="n103" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n104" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n105" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n106" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n37" target="n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n107" value="aged" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n38" target="n39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n108" value="rolled" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n39" target="n40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n109" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n37" target="n41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n110" value="expired" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n38" target="n42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n111" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1" source="n44" target="n45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n112" value="no" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#c62828;fontColor=#c62828;" edge="1" parent="1" source="n45" target="n46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n113" value="yes" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;" edge="1" parent="1" source="n45" target="n47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n114" value="yes" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;" edge="1" parent="1"