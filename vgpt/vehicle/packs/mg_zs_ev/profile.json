 "events": [
  {
   "id": "low12v",
   "from": "signal:aux_battery_voltage",
   "when": "<11.6",
   "hold_s": 20,
   "type": "LOW_12V",
   "severity": "warn",
   "detail": "12 V battery at {value:.2f} V"
  },
  {
   "id": "tpms_fl",
   "from": "signal:tyre_pressure_fl",
   "when": "<200",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "tyre pressure low ({value:.0f} kPa, spec 250 kPa)"
  },
  {
   "id": "tpms_fr",
   "from": "signal:tyre_pressure_fr",
   "when": "<200",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "tyre pressure low ({value:.0f} kPa, spec 250 kPa)"
  },
  {
   "id": "tpms_rl",
   "from": "signal:tyre_pressure_rl",
   "when": "<200",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "tyre pressure low ({value:.0f} kPa, spec 250 kPa)"
  },
  {
   "id": "tpms_rr",
   "from": "signal:tyre_pressure_rr",
   "when": "<200",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "tyre pressure low ({value:.0f} kPa, spec 250 kPa)"
  },
  {
   "id": "log_reset",
   "from": "log:any",
   "match": "watchdog reset",
   "max_severity": 3,
   "type": "ECU_RESET",
   "severity": "warn"
  },
  {
   "id": "log_brownout",
   "from": "log:any",
   "match": "brown-out",
   "max_severity": 3,
   "type": "VOLTAGE_DIP",
   "severity": "warn"
  },
  {
   "id": "dtc",
   "from": "uds:dtc"
  }
 ],
 "thresholds": {
  "overtemp_c": 105,
