   "unit": "km",
   "category": "battery",
   "synonyms": [
    "dashboard range",
    "range on the dashboard",
    "displayed range",
    "range shown",
    "range estimate on the dashboard",
    "reported range",
    "guess-o-meter"
   ],
   "lo": 0,
   "hi": 1500,
