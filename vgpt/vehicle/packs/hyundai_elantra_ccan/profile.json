   "detail": "tyre pressure low ({value:.0f} kPa, spec 235 kPa)"
  },
  {
   "id": "log_reset",
   "from": "log:any",
   "match": "watchdog reset",
   "max_severity": 3,
   "type": "ECU_RESET",
   "severity": "warn"
  },
  {
   "id": "log_brownout",
   "from": "log:any",
   "match": "brown-out",
   "max_severity": 3,
   "type": "VOLTAGE_DIP",
   "severity": "warn"
  },
