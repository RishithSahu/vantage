 },
 "concepts": [],
 "sources": [
  {
   "id": "party",
   "type": "can",
   "name": "Party / powertrain CAN 500 kbit/s (OEM database tesla_model3_party)",
   "dbc": "tesla_model3_party.dbc",
   "channel": "can0",
   "bitrate": 500000
  },
  {
   "id": "ext",
   "type": "can",
   "name": "Model 3 Long Range extension CAN (SYNTHETIC: quantities the open database lacks)",
   "dbc": "tesla_model_3_ext.dbc",
   "channel": "can1",
   "bitrate": 500000
  },
  {
   "id": "diag",
   "type": "uds",
   "name": "UDS / OBD-II (ISO 15765-4)",
   "response_ids": [
    "0x7E8..0x7EF"
   ],
   "dtc": "dtc.json"
  },
  {
   "id": "ivi",
   "type": "log",
   "name": "Linux telematics / infotainment (syslog)",
   "format": "rfc3164"
  },
  {
   "id": "gnss",
   "type": "gnss",
   "name": "GNSS receiver (NMEA 0183)"
  },
  {
   "id": "cam",
   "type": "camera",
   "name": "Forward camera (driver assistance)",
   "cams": [
    "front"
   ]
  }
 ],
 "signals": [
