   "concept": "speed",
   "from": "can:party/DI_speed.DI_vehicleSpeed",
   "unit": "km/h",
   "rate_hz": 20
  },
  {
   "concept": "motor_torque",
   "from": "can:party/DI_torque.DI_torqueActual",
   "unit": "Nm",
   "rate_hz": 20
  },
  {
   "concept": "accelerator_position",
   "from": "can:party/DI_systemStatus.DI_accelPedalPos",
   "unit": "%",
   "rate_hz": 20
  },
  {
   "concept": "gear",
   "from": "can:party/DI_systemStatus.DI_gear",
   "unit": "none",
   "rate_hz": 10,
   "map": {
    "DI_GEAR_P": 0,
    "DI_GEAR_R": -1,
    "DI_GEAR_N": 0,
    "DI_GEAR_D": 1
   }
  },
  {
   "concept": "_ignition",
   "from": "can:party/DI_systemStatus.DI_gear",
   "unit": "none",
   "rate_hz": 10,
   "when": ">1.5"
  },
  {
   "concept": "brake_pedal",
   "from": "can:party/DI_systemStatus.DI_brakePedalState",
   "unit": "%",
   "rate_hz": 20,
   "map": {
    "OFF": 0,
    "ON": 100
   },
   "snap": true
  },
  {
   "concept": "wheel_speed_fl",
