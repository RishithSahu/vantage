   "rate_hz": 20
  },
  {
   "concept": "wheel_speed_rl",
   "from": "can:party/ESP_wheelSpeeds.ESP_wheelSpeedReL",
   "unit": "km/h",
   "rate_hz": 20
  },
  {
   "concept": "wheel_speed_rr",
   "from": "can:party/ESP_wheelSpeeds.ESP_wheelSpeedReR",
   "unit": "km/h",
   "rate_hz": 20
  },
  {
