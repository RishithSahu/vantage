 "hypotheses": [
  {
   "signal": "coolant_flow",
   "direction": "down",
   "say": "reduced coolant flow (pump or circuit degradation)",
   "check": "coolant pump current and speed, pump DTCs, coolant level"
  },
  {
   "signal": "battery_temperature",
   "direction": "up",
   "say": "heat generated by high battery power (fast charge or sustained high-power driving) that the cooling circuit did not remove",
   "check": "coolant flow during the same interval, charging power, ambient temperature"
  },
  {
   "signal": "motor_temperature",
   "direction": "up",
   "say": "motor thermal load (sustained high speed or torque, warm ambient)",
   "check": "motor cooling circuit, torque history, ambient temperature"
  },
  {
   "signal": "aux_battery_voltage",
   "direction": "down",
   "say": "12 V supply instability (weak 12 V battery or DC/DC converter)",
   "check": "12 V battery rest voltage, DC/DC converter DTCs"
  },
  {
   "signal": "battery_voltage",
   "direction": "down",
   "say": "pack voltage sag under high current",
   "check": "cell voltage spread, pack current, state of charge"
  },
  {
   "signal": "lane_confidence",
   "direction": "down",
   "say": "degraded lane-marking visibility (worn markings, roadworks, rain, glare)",
   "check": "camera blockage and sharpness, weather, road works on the route"
  },
  {
   "signal": "camera_blockage",
   "direction": "up",
   "say": "an obstructed forward camera (dirt, rain splash, snow)",
   "check": "windscreen condition, camera self-test"
  },
  {
   "signal": "lead_vehicle_distance",
   "direction": "down",
   "say": "a closing gap to the vehicle ahead",
   "check": "radar object list, driver braking input"
  },
  {
   "signal": "tyre_pressure_fl",
   "direction": "down",
   "say": "a slow tyre leak",
   "check": "tyre inspection, pressure history of the wheel"
  },
  {
   "signal": "speed",
   "direction": "up",
   "say": "high-speed operation that raises thermal and electrical load",
   "check": "route type and speed limit"
  }
 ],
 "next_measurement": {
  "P0A94": "the DC/DC converter's own input / output voltage, current and housing temperature (the vehicle records none of them), logged at 1 Hz around each occurrence",
  "P1A00": "the coolant pump's electrical current and speed, to tell a failing pump from a blocked circuit",
  "P0562": "the 12 V rail voltage at 100 Hz during start-up and the DC/DC converter's enable state",
  "WARN_BATT_OVERTEMP": "the hottest cell's temperature and the pack inlet / outlet coolant temperatures, to tell a hot cell from a pack-wide rise",
  "WARN_OVERTEMP": "the motor winding temperature (separately from the housing) and the inverter temperature",
  "ADAS_DISENGAGE": "camera frames and radar object lists for the 10 seconds before each disengagement (the vehicle keeps only camera metadata, no pixels)",
  "UNEXPECTED_SHUTDOWN": "the 12 V rail and the high-voltage contactor state at 100 Hz in a ring buffer that survives the power loss",
  "ECU_RESET": "the reset cause register and the last boot log of the ECU that reset"
 }
}