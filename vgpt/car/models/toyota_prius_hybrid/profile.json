   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "tyre pressure low ({value:.0f} kPa, spec 230 kPa)"
  },
  {
   "id": "log_reset",
   "from": "log:any",
   "match": "watchdog reset",
   "max_severity": 3,
   "type": "ECU_RESET",
   "severity": "warn"
  },
  {
   "id": "log_brownout",
   "from": "log:any",
