 "events": [
  {
   "id": "adas_dis",
   "from": "someip:AdasState.Disengaged",
   "type": "ADAS_DISENGAGE",
   "severity": "info",
   "detail": "{reason_text}"
  },
  {
   "id": "aeb",
   "from": "someip:AdasState.AebActivation",
   "type": "AEB_ACTIVATION",
   "severity": "warn",
   "detail": "automatic emergency braking at {speed_kmh} km/h ({decel_g:.2f} g)"
  },
  {
   "id": "chg_start",
   "from": "someip:ChargingService.SessionStarted",
   "type": "CHARGE_START",
   "severity": "info",
   "detail": "{kind_text} {kw:.0f} kW"
  },
  {
   "id": "ecu_reset",
   "from": "someip:EcuSupervisor.EcuReset",
   "type": "ECU_RESET",
   "severity": "warn",
   "detail": "{ecu_text} reset ({cause_text})"
  },
  {
   "id": "shutdown",
   "from": "someip:EcuSupervisor.UnexpectedShutdown",
   "type": "UNEXPECTED_SHUTDOWN",
   "severity": "critical",
   "detail": "unexpected shutdown ({cause_text}); last valid data {last_valid_ms} ms before"
  },
  {
   "id": "vdip",
   "from": "someip:PowerManager.VoltageDip",
   "type": "VOLTAGE_DIP",
   "severity": "warn",
   "detail": "12 V supply dipped to {min_v:.1f} V for {duration_ms} ms"
  },
  {
   "id": "batt_sig",
   "from": "signal:battery_temperature",
   "when": ">45",
   "hold_s": 10,
   "type": "WARN_BATT_OVERTEMP",
   "severity": "critical",
   "detail": "Battery temperature above 45 °C ({value:.1f} °C)"
  },
  {
   "id": "tpms_fl",
   "from": "signal:tyre_pressure_fl",
   "when": "<207",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "front left tyre pressure low ({value:.0f} kPa, spec 241 kPa)"
  },
  {
   "id": "tpms_fr",
   "from": "signal:tyre_pressure_fr",
   "when": "<207",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "front right tyre pressure low ({value:.0f} kPa, spec 241 kPa)"
  },
  {
   "id": "tpms_rl",
   "from": "signal:tyre_pressure_rl",
   "when": "<207",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "rear left tyre pressure low ({value:.0f} kPa, spec 241 kPa)"
  },
  {
   "id": "tpms_rr",
   "from": "signal:tyre_pressure_rr",
   "when": "<207",
   "hold_s": 60,
   "type": "TPMS_LOW",
   "severity": "warn",
   "detail": "rear right tyre pressure low ({value:.0f} kPa, spec 241 kPa)"
  },
  {
   "id": "low12v",
   "from": "signal:aux_battery_voltage",
   "when": "<11.8",
   "hold_s": 20,
   "type": "LOW_12V",
   "severity": "warn",
   "detail": "12 V battery at {value:.2f} V"
  },
  {
   "id": "dtc",
   "from": "uds:dtc"
  }
 ],
 "transitions": [
  "adas_state"
 ],
 "thresholds": {
  "overtemp_c": 45,
  "tyre_low_kpa": 207,
  "low_12v": 11.8
 },
 "retention": {
  "fine_days": 14,
  "coarse_days": 1830,
  "log_days": 1825,
