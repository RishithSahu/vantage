 "events": [
  {
   "id": "overtemp",
   "from": "signal:motor_temperature",
   "when": ">105",
   "hold_s": 10,
   "type": "WARN_OVERTEMP",
   "severity": "critical",
   "detail": "Coolant above 105 °C ({value:.1f} °C)"
  },
  {
   "id": "low12v",
   "from": "signal:aux_battery_voltage",
   "when": "<11.6",
   "hold_s": 20,
   "type": "LOW_12V",
   "severity": "warn",
   "detail": "12 V battery at {value:.2f} V"
  },
  {
   "id": "tpms_fl",
