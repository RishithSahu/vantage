{
 "schema": "vehiclegpt.profile/1",
 "id": "generic_obd_dongle",
 "vehicle": {
  "make": "Generic",
  "model": "Petrol car with an OBD-II dongle",
  "year": 2018,
  "powertrain": "petrol",
  "specs": {
   "veh.tyre_spec_front": 230,
   "veh.tyre_spec_rear": 230,
   "veh.service_km": 10000,
   "veh.sw": "dongle 1.0",
   "veh.wheelbase_m": 2.6,
   "veh.wheel_radius_m": 0.31,
   "veh.rated_max_speed": 180,
   "veh.seats": 5,
   "veh.tank_l": 50,
   "veh.model": "Generic Petrol car with an OBD-II dongle"
  }
 },
 "concepts": [],
 "sources": [
  {
   "id": "diag",
   "type": "uds",
   "name": "UDS / OBD-II (ISO 15765-4)",
   "response_ids": [
    "0x7E8..0x7EF"
   ],
   "dtc": "dtc.json"
  },
  {
   "id": "ivi",
   "type": "log",
   "name": "Linux telematics / infotainment (syslog)",
   "format": "rfc3164"
  },
  {
   "id": "gnss",
   "type": "gnss",
   "name": "GNSS receiver (NMEA 0183)"
  }
 ],
 "signals": [
  {
   "concept": "speed",
   "from": "uds:diag/obd_speed",
   "unit": "km/h",
   "rate_hz": 5
  },
  {
   "concept": "engine_rpm",
   "from": "uds:diag/obd_rpm",
   "unit": "rpm",
   "rate_hz": 5
  },
  {
   "concept": "motor_temperature",
   "from": "uds:diag/obd_coolant_temp",
   "unit": "C",
   "rate_hz": 1
  },
  {
   "concept": "engine_load",
   "from": "uds:diag/obd_engine_load",
   "unit": "%",
   "rate_hz": 2
  },
  {
   "concept": "intake_air_temperature",
   "from": "uds:diag/obd_intake_air_temp",
   "unit": "C",
   "rate_hz": 1
  },
  {
   "concept": "mass_air_flow",
   "from": "uds:diag/obd_maf",
   "unit": "g/s",
   "rate_hz": 2
  },
  {
   "concept": "throttle_position",
   "from": "uds:diag/obd_throttle",
   "unit": "%",
   "rate_hz": 2
  },
  {
   "concept": "fuel_level",
   "from": "uds:diag/obd_fuel_level",
   "unit": "%",
   "rate_hz": 1
  },
  {
   "concept": "ambient_temperature",
   "from": "uds:diag/obd_ambient_temp",
   "unit": "C",
   "rate_hz": 1
  },
  {
   "concept": "aux_battery_voltage",
   "from": "uds:diag/obd_module_voltage",
   "unit": "V",
   "rate_hz": 1
  },
  {
   "concept": "engine_oil_temperature",
   "from": "uds:diag/obd_oil_temp",
   "unit": "C",
   "rate_hz": 1
  },
  {
   "concept": "fuel_rate",
   "from": "uds:diag/obd_fuel_rate",
   "unit": "L/h",
   "rate_hz": 2
  },
  {
   "concept": "barometric_pressure",
   "from": "uds:diag/obd_barometric",
   "unit": "kPa",
   "rate_hz": 0.5
  },
  {
   "concept": "intake_manifold_pressure",
   "from": "uds:diag/obd_intake_map",
   "unit": "kPa",
   "rate_hz": 2
  },
  {
   "concept": "ignition_timing",
   "from": "uds:diag/obd_timing_advance",
   "unit": "deg",
   "rate_hz": 2
  },
  {
   "concept": "short_term_fuel_trim",
   "from": "uds:diag/obd_fuel_trim_st1",
   "unit": "%",
   "rate_hz": 1
  },
  {
   "concept": "long_term_fuel_trim",
   "from": "uds:diag/obd_fuel_trim_lt1",
   "unit": "%",
   "rate_hz": 0.5
  }
 ],
 "events": [
  {
   "id": "overtemp",
   "from": "signal:motor_temperature",
   "when": ">105",
   "hold_s": 10,
   "type": "WARN_OVERTEMP",
   "severity": "critical",
   "detail": "Coolant above 105 °C ({value:.1f} °C)"
  },
  {
   "id": "low12v",
   "from": "signal:aux_battery_voltage",
   "when": "<11.6",
   "hold_s": 20,
   "type": "LOW_12V",
   "severity": "warn",
   "detail": "12 V battery at {value:.2f} V"
  },
  {
   "id": "log_reset",
   "from": "log:any",
   "match": "watchdog reset",
   "max_severity": 3,
   "type": "ECU_RESET",
   "severity": "warn"
  },
  {
   "id": "log_brownout",
   "from": "log:any",
   "match": "brown-out",
   "max_severity": 3,
   "type": "VOLTAGE_DIP",
   "severity": "warn"
  },
  {
   "id": "dtc",
   "from": "uds:dtc"
  }
 ],
 "thresholds": {
  "overtemp_c": 105,
  "tyre_low_kpa": 200,
  "low_12v": 11.6
 },
 "retention": {
  "fine_days": 14,
  "coarse_days": 1830,
  "log_days": 1825,
  "context_days": 1825,
  "archive_days": 1830,
  "records_days": 1825
 }
}